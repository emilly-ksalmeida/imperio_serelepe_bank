generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id               String    @id @default(uuid())
  name             String    @db.VarChar(70)
  username         String    @unique @db.VarChar(20)
  passwordHash     String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  securityAnswer   String
  securityQuestion String    @db.VarChar(100)
  role             String    @default("user") @db.VarChar(10)
  account          Accounts?
  product          Products[]
  orders           Orders[]
}

model Accounts {
  id                  String      @id(map: "Account_pkey") @default(nanoid(4))
  balance             Decimal     @default(0) @db.Decimal(20, 2)
  accountPasswordHash String
  idUser              String      @unique(map: "Account_idUser_key")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  owner               Users       @relation(fields: [idUser], references: [id], map: "Account_idUser_fkey")

  sentTransfers Transfers[] @relation("FromAccount")
  receivedTransfers Transfers[] @relation("ToAccount")
}

model Transfers {
  id        String   @id @default(uuid())
  value     Decimal  @db.Decimal(20, 2)
  createdAt DateTime @default(now())
  fromId    String
  toId      String

  fromAccount Accounts @relation("FromAccount", fields: [fromId], references: [id])
  toAccount  Accounts @relation("ToAccount", fields: [toId], references: [id])

  @@index([fromId])
  @@index([toId])
}

model Products {
  id Int    @id @default(autoincrement())
  name String @db.VarChar(100)
  description String @db.VarChar(255)
  unitPrice Decimal @db.Decimal(20, 2)
  stockQuantity Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sellerId String

  seller Users @relation(fields: [sellerId], references: [id])
  orderItems OrderItems[]
}

model Orders {
  id String @id @default(uuid())
  buyerId String
  status String @default("paid") @db.VarChar(20)
  totalAmount Decimal @db.Decimal(20, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer Users @relation(fields: [buyerId], references: [id])

  orderItems OrderItems[]
}

model OrderItems {
  id String @id @default(uuid())
  orderId String
  productId Int
  quantity Int 
  unitPriceOrdered Decimal @db.Decimal(20, 2)
  productNameOrdered String @db.VarChar(100)

  order Orders @relation(fields: [orderId], references: [id])
  product Products @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}